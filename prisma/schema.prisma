// Aurevia — PostgreSQL schema (Prisma).
// All monetary values are stored as integer minor units (cents) to avoid float drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  PACKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  IN_PRODUCTION
  COMPLETED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
}

enum DiamondOptionKind {
  CENTER_STONE // pick a loose certified diamond from inventory
  TOTAL_WEIGHT // pick a pre-set total carat weight / quality package
}

enum MetalOptionKind {
  PURITY
  COLOR
}

// ─────────────────────────────── Users ───────────────────────────────

model User {
  id           String          @id @default(cuid())
  name         String?
  email        String          @unique
  phone        String?
  passwordHash String?
  role         Role            @default(CUSTOMER)
  image        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  addresses    Address[]
  orders       Order[]
  cart         Cart?
  wishlist     Wishlist?
  compareItems CompareItem[]
  reviews      Review[]
  returns      ReturnRequest[]
  quizAnswers  RecommendationAnswer[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  firstName  String
  lastName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

// ────────────────────────────── Catalog ──────────────────────────────

model Category {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String?
  image          String?
  seoTitle       String?
  seoDescription String?
  position       Int       @default(0)
  isActive       Boolean   @default(true)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, position])
  @@map("categories")
}

model Collection {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String?
  image          String?
  seoTitle       String?
  seoDescription String?
  isFeatured     Boolean   @default(false)
  position       Int       @default(0)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isFeatured, position])
  @@map("collections")
}

model Product {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  sku               String                 @unique
  name              String
  subtitle          String?
  description       String
  details           String? // longer craftsmanship copy
  categoryId        String
  category          Category               @relation(fields: [categoryId], references: [id])
  collections       Collection[]
  /// Reference setting price (cents) at the lowest purity. Variant prices are authoritative.
  basePrice         Int
  /// Denormalised "From" price (cents): cheapest variant + cheapest diamond option. Used for filtering & sorting.
  fromPrice         Int
  metalColors       String[]
  purities          String[]
  defaultMetalColor String                 @default("yellow")
  defaultPurity     String                 @default("14K")
  shapes            String[]
  centerCarat       Float?
  totalCarat        Float?
  /// centerCarat ?? totalCarat — denormalised for carat sorting
  caratSort         Float                  @default(0)
  settingType       String?
  styles            String[]
  tags              String[]
  hasCenterStone    Boolean                @default(false)
  requiresSize      Boolean                @default(false)
  /// Procedural illustration spec used when no photography has been uploaded.
  art               Json?
  isActive          Boolean                @default(true)
  isFeatured        Boolean                @default(false)
  isTrending        Boolean                @default(false)
  isNew             Boolean                @default(false)
  position          Int                    @default(0)
  rating            Float                  @default(0)
  reviewCount       Int                    @default(0)
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  variants          ProductVariant[]
  images            ProductImage[]
  diamondOptions    ProductDiamondOption[]
  reviews           Review[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  compareItems      CompareItem[]
  orderItems        OrderItem[]

  @@index([categoryId, isActive])
  @@index([fromPrice])
  @@index([caratSort])
  @@index([createdAt])
  @@index([isTrending])
  @@index([isFeatured, position])
  @@index([shapes], type: Gin)
  @@index([metalColors], type: Gin)
  @@index([styles], type: Gin)
  @@map("products")
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  purity     String
  metalColor String
  /// Setting price in cents for this purity/colour (diamond priced separately)
  price      Int
  stock      Int         @default(10)
  isActive   Boolean     @default(true)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, purity, metalColor])
  @@index([stock])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  /// image | video | spin360
  kind       String   @default("image")
  metalColor String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

model MetalOption {
  id              String          @id @default(cuid())
  kind            MetalOptionKind
  code            String          @unique // e.g. "14K" or "yellow"
  label           String
  description     String?
  priceMultiplier Float           @default(1)
  position        Int             @default(0)
  isActive        Boolean         @default(true)

  @@map("metal_options")
}

model Diamond {
  id           String              @id @default(cuid())
  sku          String              @unique
  shape        String
  carat        Float
  color        String
  clarity      String
  cut          String
  polish       String              @default("Excellent")
  symmetry     String              @default("Excellent")
  fluorescence String              @default("None")
  measurements String?
  tablePct     Float?
  depthPct     Float?
  ratio        Float?
  /// CVD | HPHT
  growth       String              @default("CVD")
  price        Int
  isAvailable  Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  certificate  DiamondCertificate?
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([shape, carat])
  @@index([price])
  @@index([isAvailable])
  @@map("diamonds")
}

model DiamondCertificate {
  id        String    @id @default(cuid())
  diamondId String    @unique
  diamond   Diamond   @relation(fields: [diamondId], references: [id], onDelete: Cascade)
  lab       String // IGI | GIA
  number    String    @unique
  url       String?
  issuedAt  DateTime?

  @@map("diamond_certificates")
}

model ProductDiamondOption {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind       DiamondOptionKind
  // CENTER_STONE fields
  shape      String?
  minCarat   Float?
  maxCarat   Float?
  // TOTAL_WEIGHT fields
  label      String?
  totalCarat Float?
  color      String?
  clarity    String?
  priceDelta Int               @default(0)
  isDefault  Boolean           @default(false)
  position   Int               @default(0)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_diamond_options")
}

// ──────────────────────── Cart / Wishlist / Compare ────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@map("cart")
}

model CartItem {
  id              String                @id @default(cuid())
  cartId          String
  cart            Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  diamondId       String?
  diamond         Diamond?              @relation(fields: [diamondId], references: [id], onDelete: SetNull)
  diamondOptionId String?
  diamondOption   ProductDiamondOption? @relation(fields: [diamondOptionId], references: [id], onDelete: SetNull)
  ringSize        String?
  quantity        Int                   @default(1)
  createdAt       DateTime              @default(now())

  @@index([cartId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  updatedAt DateTime       @updatedAt

  @@map("wishlist")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("compare_items")
}

// ─────────────────────────────── Orders ───────────────────────────────

model Order {
  id              String          @id @default(cuid())
  number          String          @unique
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  phone           String?
  customerName    String
  shippingAddress Json
  billingAddress  Json?
  deliveryMethod  String
  status          OrderStatus     @default(PENDING)
  currency        String          @default("INR")
  subtotal        Int
  discount        Int             @default(0)
  shipping        Int             @default(0)
  tax             Int             @default(0)
  total           Int
  couponCode      String?
  /// Customer's own note from checkout (never edited by staff)
  notes           String?
  /// Internal staff / system notes — never shown to the customer
  adminNotes      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]
  returns         ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("orders")
}

model OrderItem {
  id              String                @id @default(cuid())
  orderId         String
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  diamondId       String?
  diamond         Diamond?              @relation(fields: [diamondId], references: [id], onDelete: SetNull)
  diamondOptionId String?
  diamondOption   ProductDiamondOption? @relation(fields: [diamondOptionId], references: [id], onDelete: SetNull)
  name            String
  sku             String
  slug            String?
  purity          String
  metalColor      String
  diamondSummary  String?
  ringSize        String?
  quantity        Int
  unitPrice       Int
  lineTotal       Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // razorpay | stripe | demo
  method            String? // upi | card | netbanking | wallet
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  providerOrderId   String?
  providerPaymentId String?
  signature         String?
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([providerOrderId])
  @@map("payments")
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String         @default("Insured Courier")
  method         String
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType
  /// PERCENT: whole percent (e.g. 10). FIXED: cents.
  value       Int
  minSubtotal Int        @default(0)
  maxUses     Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@map("coupons")
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String
  details   String?
  status    ReturnStatus @default(REQUESTED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orderId])
  @@map("return_requests")
}

// ───────────────────────────── Engagement ─────────────────────────────

model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  location   String?
  rating     Int
  title      String
  body       String
  status     ReviewStatus @default(PENDING)
  isVerified Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

model BespokeRequest {
  id             String        @id @default(cuid())
  jewelryType    String
  shape          String?
  carat          String?
  metal          String?
  budget         String?
  inspirationUrls String[]
  notes          String?
  name           String
  email          String
  phone          String?
  country        String?
  status         RequestStatus @default(NEW)
  adminNotes     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("bespoke_requests")
}

model PartnerApplication {
  id           String            @id @default(cuid())
  name         String
  email        String
  phone        String?
  country      String
  company      String?
  website      String?
  socialHandle String?
  audienceSize String?
  experience   String?
  message      String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@map("partner_applications")
}

model RecommendationQuiz {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  title     String
  questions Json
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  answers   RecommendationAnswer[]

  @@map("recommendation_quiz")
}

model RecommendationAnswer {
  id             String             @id @default(cuid())
  quizId         String
  quiz           RecommendationQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers        Json
  recommendedIds String[]
  createdAt      DateTime           @default(now())

  @@index([quizId])
  @@map("recommendation_answers")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

/// Key/value store settings editable from the admin (announcement bar, shipping, tax, hero copy…)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
