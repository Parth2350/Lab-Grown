# ── Core ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows demo-login hints on the sign-in page. Set to false in production.
NEXT_PUBLIC_DEMO_MODE=true
# Local dev uses the embedded PostgreSQL started by `npm run db:start` (port 5433).
# In production point this at any PostgreSQL 14+ instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aurevia?schema=public

# ── Auth (NextAuth) ──────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments ─────────────────────────────────────────────────────────
# Leave blank to use the built-in demo payment flow (no real charges).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Webhook (payment.captured / order.paid → /api/payments/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=

# ── Image storage (Cloudinary). Blank = uploads saved to /public/uploads ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cache (optional). Blank = in-memory cache ─────────────────────────
REDIS_URL=

# ── Embedded dev database location (outside OneDrive/Dropbox is best) ──
# PG_DATA_DIR=C:/Users/you/.aurevia/pgdata
