{
  "name": "aurevia-fine-jewelry",
  "version": "1.0.0",
  "private": true,
  "description": "Aurevia — premium lab-grown diamond fine jewelry storefront and admin.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "qa": "node scripts/qa/admin.mjs && node scripts/qa/sweep.mjs && node scripts/qa/whatsapp.mjs && node scripts/qa/welcome.mjs && node scripts/qa/bespoke.mjs",
    "qa:admin": "node scripts/qa/admin.mjs",
    "qa:sweep": "node scripts/qa/sweep.mjs",
    "qa:whatsapp": "node scripts/qa/whatsapp.mjs",
    "qa:welcome": "node scripts/qa/welcome.mjs",
    "qa:bespoke": "node scripts/qa/bespoke.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.27",
    "next-auth": "4.24.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "18.4.0-beta.17",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
